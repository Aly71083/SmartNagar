@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Privacy Policy - Smart Nagar</title>

    <style>
        body {
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: #faf7ff;
            color: #2d3748;
        }

        .topbar {
            padding: 18px 24px;
            background: white;
            border-bottom: 1px solid #eee;
        }

        .back {
            text-decoration: none;
            color: #7c4dff;
            font-weight: 800;
        }

        .wrap {
            width: min(900px, 92%);
            margin: 60px auto;
        }

        .title {
            font-size: 42px;
            font-weight: 1000;
            margin-bottom: 12px;
            color: #7c4dff;
        }

        .sub {
            color: #6b7280;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 10px 30px rgba(124,77,255,.08);
            margin-bottom: 20px;
        }

        h3 {
            margin-top: 0;
            color: #4c1d95;
        }

        p {
            line-height: 1.8;
            color: #4b5563;
        }
    </style>
</head>
<body>

    <div class="topbar">
        <a href="/" class="back">← Back to Home</a>
    </div>

    <div class="wrap">
        <div class="title">Privacy Policy</div>
        <div class="sub">Last updated: 2026</div>

        <div class="card">
            <h3>1. Information We Collect</h3>
            <p>
                We collect information such as your name, email address, and activity within the platform
                to improve municipal services and user experience.
            </p>
        </div>

        <div class="card">
            <h3>2. How We Use Your Data</h3>
            <p>
                Your data is used to process complaints, provide updates, and improve Smart Nagar services.
                We do not sell your personal information.
            </p>
        </div>

        <div class="card">
            <h3>3. Data Security</h3>
            <p>
                We use secure authentication and encryption methods to protect your data.
            </p>
        </div>

        <div class="card">
            <h3>4. User Rights</h3>
            <p>
                You can update, modify, or delete your account information at any time.
            </p>
        </div>

        <div class="card">
            <h3>5. Contact</h3>
            <p>
                If you have any questions, contact us at support@smartnagar.gov.np
            </p>
        </div>
    </div>

</body>
</html>