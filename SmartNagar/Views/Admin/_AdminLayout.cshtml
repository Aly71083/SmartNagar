@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    Layout = null;
    var active = ViewBag.Active as string ?? "";
    var pageTitle = ViewBag.PageTitle as string ?? Localizer["Admin Panel"].Value;
    var adminName = User?.Identity?.Name ?? "Admin";

    Func<string, string> isActive = key => active == key ? "active" : "";

    var culture = CultureInfo.CurrentUICulture?.Name ?? "en-US";
    var isNepali = culture.StartsWith("ne", StringComparison.OrdinalIgnoreCase);

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var adminInitial = !string.IsNullOrWhiteSpace(adminName) ? adminName.Substring(0, 1).ToUpper() : "A";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - Smart Nagar</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --bg: #f6f0ff;
            --card: #fcfaff;
            --border: #e6dcf7;
            --text: #33214d;
            --muted: #7c6f98;
            --sidebar1: #8f7aea;
            --sidebar2: #6f5bd3;
            --white: #fffefe;
            --shadow: 0 10px 24px rgba(95, 85, 160, .12);
            --danger: #ef4444;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", system-ui, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        a {
            text-decoration: none;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, var(--sidebar1), var(--sidebar2));
            color: var(--white);
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            padding: 18px 16px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            box-shadow: 4px 0 18px rgba(0,0,0,.06);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 10px;
            font-size: 18px;
            font-weight: 900;
        }

        .logo {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: rgba(255,255,255,.20);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .brand small {
            display: block;
            margin-top: 2px;
            font-size: 12px;
            font-weight: 700;
            opacity: .95;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 6px;
        }

            .menu a {
                display: flex;
                align-items: center;
                gap: 10px;
                color: var(--white);
                padding: 12px 14px;
                border-radius: 14px;
                font-weight: 850;
                transition: .2s ease;
            }

                .menu a:hover {
                    background: rgba(255,255,255,.18);
                }

                .menu a.active {
                    background: rgba(255,255,255,.28);
                }

        .sidebarBottom {
            margin-top: auto;
            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,.14);
        }

        .adminProfileCard {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.16);
            border-radius: 16px;
            padding: 12px 12px;
            margin-bottom: 12px;
            backdrop-filter: blur(2px);
        }

        .adminAvatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #f4f0ff;
            color: #6d28d9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 900;
            flex-shrink: 0;
        }

        .adminMeta {
            min-width: 0;
            line-height: 1.2;
        }

            .adminMeta .name {
                font-weight: 900;
                font-size: 13px;
                color: #fff;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .adminMeta .role {
                font-size: 11px;
                color: rgba(255,255,255,.88);
                margin-top: 3px;
                font-weight: 700;
            }

        .logoutForm {
            margin: 0;
        }

        .logoutBtn {
            width: 100%;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 14px;
            border-radius: 14px;
            background: rgba(255,255,255,.18);
            color: #fff;
            font-weight: 900;
            cursor: pointer;
            transition: .2s ease;
            border: 1px solid rgba(255,255,255,.14);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
        }

            .logoutBtn:hover {
                background: rgba(255,255,255,.26);
                transform: translateY(-1px);
            }

        .main {
            margin-left: 260px;
            width: calc(100% - 260px);
            min-height: 100vh;
            padding: 20px;
            background: var(--bg);
        }

        .topbar {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 16px 18px;
            box-shadow: var(--shadow);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

            .topbar h1 {
                margin: 0;
                font-size: 24px;
                font-weight: 900;
                color: var(--text);
            }

            .topbar p {
                margin: 4px 0 0;
                color: var(--muted);
                font-weight: 700;
                font-size: 13px;
            }

        .topActions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            position: relative;
        }

        .langForm {
            margin: 0;
        }

        .langSwitch {
            display: flex;
            align-items: center;
            background: #f5f0ff;
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 4px;
            gap: 4px;
        }

        .langBtn {
            border: none;
            background: transparent;
            color: var(--text);
            padding: 8px 14px;
            border-radius: 999px;
            font-weight: 800;
            cursor: pointer;
        }

            .langBtn.active {
                background: #8b5cf6;
                color: #fff;
            }

        .notifWrap {
            position: relative;
        }

        .notifBtn {
            width: 46px;
            height: 46px;
            border: 1px solid var(--border);
            background: #f7f3ff;
            border-radius: 14px;
            cursor: pointer;
            position: relative;
            color: #6d28d9;
            font-size: 18px;
            transition: .2s ease;
        }

            .notifBtn:hover {
                background: #efe7ff;
            }

        .notifBadge {
            position: absolute;
            top: -5px;
            right: -5px;
            min-width: 22px;
            height: 22px;
            padding: 0 6px;
            border-radius: 999px;
            background: var(--danger);
            color: #fff;
            font-size: 11px;
            font-weight: 900;
            display: none;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
            box-shadow: 0 8px 20px rgba(239,68,68,.28);
        }

        .notifPanel {
            position: absolute;
            top: 56px;
            right: 0;
            width: 360px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(124,58,237,.18);
            overflow: hidden;
            display: none;
            z-index: 1000;
        }

            .notifPanel.show {
                display: block;
            }

        .notifHead {
            padding: 14px 16px;
            border-bottom: 1px solid #f0eaff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            background: #fcfaff;
        }

            .notifHead strong {
                color: var(--text);
                font-size: 15px;
            }

        .notifActions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .miniBtn {
            border: none;
            background: #ede4ff;
            color: var(--text);
            padding: 8px 10px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .miniBtn:hover {
                background: #e3d6ff;
            }

        .notifBody {
            max-height: 360px;
            overflow-y: auto;
            padding: 12px;
        }

        .notifItem {
            padding: 12px;
            border: 1px solid #efe9ff;
            border-radius: 14px;
            background: #fff;
            margin-bottom: 10px;
        }

            .notifItem.unread {
                background: #faf6ff;
                border-color: #dccbff;
            }

        .notifType {
            display: inline-block;
            margin-bottom: 8px;
            padding: 4px 8px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 900;
            background: #ede4ff;
            color: #6d28d9;
        }

            .notifType.emergency {
                background: #fee2e2;
                color: #b91c1c;
            }

        .notifTitle {
            font-size: 14px;
            font-weight: 900;
            color: var(--text);
            margin-bottom: 4px;
        }

        .notifText {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.5;
            font-weight: 700;
        }

        .notifTime {
            margin-top: 8px;
            font-size: 11px;
            color: #8b7aa9;
            font-weight: 700;
        }

        .notifEmpty {
            padding: 20px;
            text-align: center;
            color: var(--muted);
            font-weight: 800;
            font-size: 13px;
        }

        .pageBody {
            margin-top: 16px;
        }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                width: 100%;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .notifPanel {
                width: 320px;
                right: -20px;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="brand">
                <div class="logo"><i class="fa-solid fa-landmark"></i></div>
                <div>
                    Smart Nagar
                    <small>@Localizer["Admin Panel"]</small>
                </div>
            </div>

            <nav class="menu">
                <a class="@isActive("dashboard")" href="/Admin/Dashboard">
                    <i class="fa-solid fa-house"></i> @Localizer["Dashboard"]
                </a>

                <a class="@isActive("users")" href="/Admin/ManageUsers">
                    <i class="fa-solid fa-users"></i> @Localizer["Manage Users"]
                </a>

                <a class="@isActive("overview")" href="/Admin/SystemOverview">
                    <i class="fa-solid fa-chart-column"></i> @Localizer["System Overview"]
                </a>

                <a class="@isActive("publish")" href="/Admin/PublishNotice">
                    <i class="fa-solid fa-bullhorn"></i> @Localizer["Publish Notice"]
                </a>

                <a class="@isActive("notices")" href="/Admin/Notices">
                    <i class="fa-solid fa-folder-open"></i> @Localizer["Notices"]
                </a>

                <a class="@isActive("garbage")" href="/Admin/GarbageSchedules">
                    <i class="fa-solid fa-trash-can"></i> @Localizer["Garbage Schedules"]
                </a>
            </nav>

            <div class="sidebarBottom">
                <div class="adminProfileCard">
                    <div class="adminAvatar">@adminInitial</div>
                    <div class="adminMeta">
                        <div class="name">@adminName</div>
                        <div class="role">@Localizer["System Admin"]</div>
                    </div>
                </div>

                <form method="post" action="/Account/Logout" class="logoutForm">
                    @Html.AntiForgeryToken()
                    <button class="logoutBtn" type="submit">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>@Localizer["Logout"]</span>
                    </button>
                </form>
            </div>
        </aside>

        <main class="main">
            <div class="topbar">
                <div>
                    <h1>@pageTitle</h1>
                    <p>@Localizer["Admin Subtitle"]</p>
                </div>

                <div class="topActions">
                    <form class="langForm" method="post" action="/Settings/SetLanguage">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <div class="langSwitch">
                            <button type="submit" name="culture" value="en-US" class="langBtn @(isNepali ? "" : "active")">EN</button>
                            <button type="submit" name="culture" value="ne-NP" class="langBtn @(isNepali ? "active" : "")">नेपाली</button>
                        </div>
                    </form>

                    <div class="notifWrap">
                        <button type="button" class="notifBtn" id="adminNotifBtn" onclick="toggleAdminNotifPanel()">
                            <i class="fa-regular fa-bell"></i>
                            <span class="notifBadge" id="adminNotifBadge">0</span>
                        </button>

                        <div class="notifPanel" id="adminNotifPanel">
                            <div class="notifHead">
                                <strong>Admin Notifications</strong>
                                <div class="notifActions">
                                    <button type="button" class="miniBtn" onclick="markAllAdminRead()">Mark all read</button>
                                    <a href="/Admin/Notifications" class="miniBtn">View all</a>
                                </div>
                            </div>

                            <div class="notifBody" id="adminNotifBody">
                                <div class="notifEmpty">Loading notifications...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pageBody">
                @RenderBody()
            </div>
        </main>
    </div>

    <script>
        function toggleAdminNotifPanel() {
            const panel = document.getElementById("adminNotifPanel");
            panel.classList.toggle("show");

            if (panel.classList.contains("show")) {
                loadAdminNotifications();
            }
        }

        document.addEventListener("click", function (e) {
            const wrap = document.querySelector(".notifWrap");
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById("adminNotifPanel").classList.remove("show");
            }
        });

        function getAdminAntiForgeryToken() {
            const tokenInput = document.querySelector('.langForm input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        async function refreshAdminNotificationCount() {
            try {
                const res = await fetch('/Admin/UnreadActivityCount');
                if (!res.ok) return;

                const data = await res.json();
                const badge = document.getElementById("adminNotifBadge");
                const count = data.count || 0;

                if (count > 0) {
                    badge.style.display = "flex";
                    badge.innerText = count > 99 ? "99+" : count;
                } else {
                    badge.style.display = "none";
                }
            } catch (e) {
                console.log("Admin unread count load failed");
            }
        }

        async function loadAdminNotifications() {
            const body = document.getElementById("adminNotifBody");

            try {
                const res = await fetch('/Admin/RecentActivitiesPreview');
                if (!res.ok) {
                    body.innerHTML = '<div class="notifEmpty">Could not load notifications.</div>';
                    return;
                }

                const items = await res.json();

                if (!items || items.length === 0) {
                    body.innerHTML = '<div class="notifEmpty">No notifications found.</div>';
                    return;
                }

                let html = '';

                items.forEach(item => {
                    const isEmergency = (item.type || '').toLowerCase() === 'emergency';

                    html += `
                        <div class="notifItem ${item.isRead ? '' : 'unread'}">
                            <div class="notifType ${isEmergency ? 'emergency' : ''}">
                                ${isEmergency ? '🚨 Emergency' : (item.type || 'Activity')}
                            </div>
                            <div class="notifTitle">${item.title || 'Activity'}</div>
                            <div class="notifText">${item.detail || ''}</div>
                            <div class="notifTime">${item.createdAtText || ''}</div>
                        </div>
                    `;
                });

                body.innerHTML = html;
            } catch (e) {
                body.innerHTML = '<div class="notifEmpty">Could not load notifications.</div>';
            }
        }

        async function markAllAdminRead() {
            try {
                const res = await fetch('/Admin/MarkAllRead', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getAdminAntiForgeryToken()
                    }
                });

                if (res.ok) {
                    await refreshAdminNotificationCount();
                    await loadAdminNotifications();
                }
            } catch (e) {
                console.log("Mark all read failed");
            }
        }

        refreshAdminNotificationCount();
        setInterval(refreshAdminNotificationCount, 15000);
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>