@model SmartNagar.ViewModels.VerifyEmailOtpVM
@{
    Layout = null;
    ViewData["Title"] = "Verify Email OTP";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verify Email | Smart Nagar</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", system-ui, Arial, sans-serif;
            background: linear-gradient(135deg, #7c4dff, #ec4899);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .card {
            width: 100%;
            max-width: 520px;
            background: #fff;
            border-radius: 24px;
            padding: 32px;
            box-shadow: 0 25px 60px rgba(124,77,255,.25);
        }

        .logo {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            margin: 0 auto 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #7c4dff, #ec4899);
            color: #fff;
            font-size: 28px;
        }

        h1 {
            margin: 0 0 8px;
            text-align: center;
            font-size: 30px;
            font-weight: 900;
            color: #111827;
        }

        .sub {
            text-align: center;
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 24px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 800;
            color: #374151;
        }

        input {
            width: 100%;
            height: 56px;
            border-radius: 16px;
            border: 1px solid #e5e7eb;
            outline: none;
            padding: 0 16px;
            font-size: 16px;
            margin-bottom: 8px;
        }

            input:focus {
                border-color: #a855f7;
                box-shadow: 0 0 0 4px rgba(168,85,247,.12);
            }

        .text-danger,
        .field-validation-error {
            display: block;
            color: #dc2626;
            font-size: 12px;
            margin-top: 4px;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .summary-errors {
            margin-bottom: 16px;
            padding: 12px 14px;
            border-radius: 14px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 13px;
        }

        .msg-success {
            margin-bottom: 16px;
            padding: 12px 14px;
            border-radius: 14px;
            background: #ecfdf5;
            border: 1px solid #86efac;
            color: #166534;
            font-size: 13px;
            font-weight: 700;
        }

        .msg-error {
            margin-bottom: 16px;
            padding: 12px 14px;
            border-radius: 14px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 13px;
            font-weight: 700;
        }

        .btn {
            width: 100%;
            height: 52px;
            border: none;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 900;
            cursor: pointer;
        }

        .btn-primary {
            background: linear-gradient(135deg, #7c4dff, #ec4899);
            color: #fff;
            box-shadow: 0 14px 30px rgba(124,77,255,.25);
            margin-top: 10px;
        }

        .btn-secondary {
            margin-top: 12px;
            background: #fff;
            border: 1px solid #e5e7eb;
            color: #374151;
        }

        .bottom {
            margin-top: 18px;
            text-align: center;
            font-size: 14px;
        }

            .bottom a {
                text-decoration: none;
                color: #a855f7;
                font-weight: 800;
            }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo">✉️</div>
        <h1>Verify your email</h1>
        <div class="sub">Enter the 6-digit OTP sent to your email address.</div>

        @if (TempData["SuccessMsg"] != null)
        {
            <div class="msg-success">@TempData["SuccessMsg"]</div>
        }

        @if (TempData["ErrorMsg"] != null)
        {
            <div class="msg-error">@TempData["ErrorMsg"]</div>
        }

        <div asp-validation-summary="All" class="summary-errors"></div>

        <form asp-action="VerifyEmailOtp" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="Email" type="hidden" />

            <label>Email</label>
            <input value="@Model.Email" readonly />

            <label asp-for="OtpCode"></label>
            <input asp-for="OtpCode" placeholder="Enter 6-digit OTP" maxlength="6" />
            <span asp-validation-for="OtpCode" class="text-danger"></span>

            <button type="submit" class="btn btn-primary">Verify Email</button>
        </form>

        <form asp-action="ResendEmailOtp" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@Model.Email" />
            <button type="submit" class="btn btn-secondary">Resend OTP</button>
        </form>

        <div class="bottom">
            <a href="/Account/Login">Back to Login</a>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>