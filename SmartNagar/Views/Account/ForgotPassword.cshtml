@model SmartNagar.ViewModels.ForgotPasswordVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password</title>
    <style>
        body {
            margin: 0;
            font-family: Segoe UI,system-ui;
            background: #f5f7fb;
            display: grid;
            place-items: center;
            min-height: 100vh;
            padding: 18px;
        }

        .card {
            width: min(520px,95%);
            background: #fff;
            border: 1px solid #eef2f7;
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 18px 55px rgba(15,23,42,.12);
        }

        h2 {
            margin: 0 0 6px;
            font-weight: 1000
        }

        p {
            margin: 0 0 14px;
            color: #64748b;
            font-weight: 700
        }

        label {
            display: block;
            font-weight: 900;
            margin: 10px 0 6px
        }

        input {
            width: 100%;
            padding: 12px 14px;
            border-radius: 14px;
            border: 1px solid #e2e8f0;
            outline: none;
            font-weight: 700
        }

        .btn {
            margin-top: 14px;
            width: 100%;
            padding: 12px 14px;
            border: none;
            border-radius: 14px;
            font-weight: 1000;
            cursor: pointer;
            background: linear-gradient(135deg,#06b6d4,#10b981);
            color: #fff
        }

        .msgBox {
            margin-top: 14px;
            padding: 12px;
            border-radius: 14px;
            background: #ecfeff;
            border: 1px solid #a5f3fc;
            color: #0f766e;
            font-weight: 800;
        }

        .back {
            display: block;
            margin-top: 12px;
            text-align: center;
            font-weight: 900;
            text-decoration: none;
            color: #0b5cff
        }

        .err {
            color: #ef4444;
            font-weight: 800;
            margin-top: 10px
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Forgot Password</h2>
        <p>Enter your email and we will send a password reset link to your inbox.</p>

        <form method="post" asp-action="ForgotPassword">
            @Html.AntiForgeryToken()

            <label>Email</label>
            <input asp-for="Email" placeholder="your@email.com" />
            <span class="err" asp-validation-for="Email"></span>

            <button class="btn" type="submit">Send Reset Link</button>

            @if (TempData["Msg"] != null)
            {
                <div class="msgBox">
                    @TempData["Msg"]
                </div>
            }

            <a class="back" href="/Account/Login">← Back to Login</a>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>