@model List<SmartNagar.Models.CitizenNotification>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    Layout = "~/Views/Citizen/_CitizenLayout.cshtml";
    ViewBag.Title = "Notifications";
    ViewBag.Active = "notifications";
}

<style>
    .page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .headerCard {
        background: #fff;
        border: 1px solid #ece8fb;
        border-radius: 20px;
        padding: 20px;
        margin-bottom: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        box-shadow: 0 8px 22px rgba(73, 61, 163, .06);
    }

        .headerCard h2 {
            margin: 0;
            font-weight: 900;
            color: #5b4fcf;
            font-size: 26px;
        }

        .headerCard p {
            margin: 6px 0 0;
            color: #7b74a3;
            font-size: 14px;
            font-weight: 600;
        }

    .backBtn {
        text-decoration: none;
        border: 1px solid #dcd2ff;
        background: #fff;
        color: #5b4fcf;
        padding: 10px 16px;
        border-radius: 12px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: .2s ease;
    }

        .backBtn:hover {
            background: #f8f5ff;
        }

    .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .card {
        background: #fff;
        border-radius: 18px;
        padding: 18px;
        border: 1px solid #ece8fb;
        transition: .2s ease;
        box-shadow: 0 8px 20px rgba(91, 79, 207, .06);
    }

        .card.unread {
            background: #faf8ff;
            border-color: #d9ceff;
        }

        .card:hover {
            transform: translateY(-2px);
        }

    .type {
        font-size: 12px;
        font-weight: 900;
        padding: 5px 10px;
        border-radius: 999px;
        display: inline-block;
        margin-bottom: 10px;
        background: #eee8ff;
        color: #5b4fcf;
    }

        .type.emergency {
            background: #fee2e2;
            color: #b91c1c;
        }

        .type.complaint {
            background: #fef3c7;
            color: #92400e;
        }

        .type.garbage {
            background: #f3e8ff;
            color: #7e22ce;
        }

    .title {
        font-weight: 900;
        font-size: 16px;
        color: #2d2d2d;
        margin-bottom: 6px;
    }

    .msg {
        font-size: 14px;
        color: #5f5a7c;
        font-weight: 600;
        line-height: 1.6;
    }

    .time {
        margin-top: 10px;
        font-size: 12px;
        color: #8a83aa;
        font-weight: 700;
    }

    .empty {
        text-align: center;
        padding: 40px 20px;
        color: #777;
        font-weight: 800;
        background: #fff;
        border: 1px solid #ece8fb;
        border-radius: 18px;
    }

    @@media (max-width: 700px) {
        .headerCard {
            padding: 18px;
        }

            .headerCard h2 {
                font-size: 22px;
            }
    }
</style>

<div class="page">
    <div class="headerCard">
        <div>
            <h2>🔔 Notifications</h2>
            <p>View your latest complaint updates and system alerts.</p>
        </div>

        <a href="/Citizen/Dashboard" class="backBtn">
            <i class="fa-solid fa-arrow-left"></i>
            Back
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty">
            No notifications yet.
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var n in Model)
            {
                var typeLower = (n.Type ?? "").ToLower();
                var typeClass =
                typeLower.Contains("emergency") ? "emergency" :
                typeLower.Contains("complaint") ? "complaint" :
                typeLower.Contains("garbage") ? "garbage" :
                "";

                <div class="card @(n.IsRead ? "" : "unread")">
                    <div class="type @typeClass">
                        @(string.IsNullOrWhiteSpace(n.Type) ? "Notification" : n.Type)
                    </div>

                    <div class="title">
                        @(string.IsNullOrWhiteSpace(n.Title) ? "Notification" : n.Title)
                    </div>

                    <div class="msg">
                        @(string.IsNullOrWhiteSpace(n.Message) ? "-" : n.Message)
                    </div>

                    <div class="time">
                        @n.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                    </div>
                </div>
            }
        </div>
    }
</div>