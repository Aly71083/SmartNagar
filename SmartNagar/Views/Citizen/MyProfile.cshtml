@model SmartNagar.ViewModels.ProfileViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    Layout = "~/Views/Citizen/_CitizenLayout.cshtml";
    ViewBag.Active = "MyProfile";
    ViewBag.FullName = Model?.FullName ?? Localizer["Citizen"].Value;
}

<style>
    .mp-shell {
        padding: 0;
        background: transparent;
        border: none;
        box-shadow: none;
    }

    .mp-top {
        background: #fff;
        border: 1px solid #eadffd;
        border-radius: 16px;
        padding: 22px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 16px;
        box-shadow: 0 10px 22px rgba(124,77,255,.08);
    }

        .mp-top h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 1000;
            color: #312e81;
        }

        .mp-top p {
            margin: 6px 0 0;
            color: #64748b;
            font-size: 13px;
            font-weight: 750;
        }

    .mp-top-btns {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .mp-btn,
    .mp-edit-btn,
    .mp-ghost-btn {
        border-radius: 12px;
        font-weight: 900;
        cursor: pointer;
        transition: .15s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .mp-btn {
        padding: 10px 14px;
        border: 1px solid #eadffd;
        background: #fff;
        color: #7c4dff;
        box-shadow: 0 8px 18px rgba(124,77,255,.06);
    }

    .mp-edit-btn {
        border: none;
        padding: 10px 14px;
        background: linear-gradient(90deg,#7c4dff,#a78bfa);
        color: #fff;
        box-shadow: 0 12px 24px rgba(124,77,255,.16);
    }

    .mp-ghost-btn {
        border: 1px solid #eadffd;
        background: #fff;
        color: #7c4dff;
        padding: 12px 16px;
    }

        .mp-btn:hover,
        .mp-edit-btn:hover,
        .mp-ghost-btn:hover {
            transform: translateY(-1px);
        }

    .mp-msg {
        margin: 0 0 14px;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid #bbf7d0;
        background: #ecfdf5;
        color: #14532d;
        font-weight: 900;
    }

    .mp-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 16px;
        align-items: start;
    }

    .mp-left-card,
    .mp-right-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eadffd;
        box-shadow: 0 10px 22px rgba(124,77,255,.08);
    }

    .mp-left-card {
        overflow: hidden;
    }

    .mp-left-hero {
        padding: 22px 18px;
        background: linear-gradient(90deg,#7c4dff,#a78bfa);
        color: #fff;
        text-align: center;
        position: relative;
    }

    .mp-pill {
        position: absolute;
        top: 14px;
        left: 14px;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.22);
        color: #fff;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .mp-avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        margin: 10px auto 12px;
        display: grid;
        place-items: center;
        font-size: 28px;
        font-weight: 1000;
        color: #7c4dff;
        background: #fff;
        border: 2px solid rgba(255,255,255,.7);
        box-shadow: 0 12px 24px rgba(0,0,0,.10);
    }

    .mp-name {
        margin-top: 4px;
        font-size: 24px;
        font-weight: 1000;
        line-height: 1.2;
    }

    .mp-sub {
        margin-top: 6px;
        font-size: 12px;
        font-weight: 750;
        opacity: .96;
        word-break: break-word;
    }

    .mp-verified {
        margin-top: 12px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.22);
        font-size: 12px;
        font-weight: 900;
    }

    .mp-left-menu {
        padding: 12px;
        display: grid;
        gap: 8px;
    }

    .mp-tab {
        width: 100%;
        border: 1px solid #eadffd;
        background: #fff;
        border-radius: 14px;
        padding: 12px;
        cursor: pointer;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #111827;
        transition: .15s ease;
    }

        .mp-tab:hover {
            background: #faf8ff;
        }

        .mp-tab.active {
            background: #f7f3ff;
            border-color: #d9c8ff;
            box-shadow: inset 4px 0 0 #7c4dff;
            color: #312e81;
        }

    .mp-right-card {
        padding: 18px;
    }

    .mp-section {
        padding: 6px 4px 16px;
        border-bottom: 1px solid #f1ebff;
        margin-bottom: 16px;
    }

        .mp-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

    .mp-sec-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

        .mp-sec-head h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 1000;
            color: #312e81;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .mp-fields {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .mp-field-box {
        background: #fff;
        border: 1px solid #eadffd;
        border-radius: 16px;
        padding: 14px;
        position: relative;
    }

        .mp-field-box:before {
            content: "";
            position: absolute;
            left: 0;
            top: 10px;
            bottom: 10px;
            width: 4px;
            border-radius: 999px;
            background: #7c4dff;
        }

        .mp-field-box small {
            display: block;
            font-size: 11px;
            letter-spacing: .7px;
            text-transform: uppercase;
            font-weight: 800;
            color: #64748b;
            padding-left: 12px;
            margin-bottom: 6px;
        }

        .mp-field-box input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            font-size: 15px;
            font-weight: 900;
            color: #111827;
            font-family: inherit;
            padding-left: 12px;
        }

    .mp-full {
        grid-column: 1 / -1;
    }

    .mp-hint {
        margin-top: 12px;
        background: #f8f5ff;
        border: 1px solid #eadffd;
        color: #5b21b6;
        border-radius: 14px;
        padding: 12px 14px;
        font-weight: 800;
        line-height: 1.6;
    }

    .mp-field-error {
        color: #ef4444;
        font-weight: 800;
        font-size: 12px;
        margin-top: 6px;
        display: block;
        padding-left: 12px;
    }

    .mp-danger-zone {
        background: #fff;
        border: 1px solid #fecaca;
        border-radius: 16px;
        padding: 14px;
    }

        .mp-danger-zone h4 {
            margin: 0 0 10px;
            font-size: 16px;
            font-weight: 1000;
            color: #991b1b;
        }

    .mp-danger-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .mp-btn-warn {
        border: none;
        cursor: pointer;
        font-weight: 1000;
        border-radius: 12px;
        padding: 12px 16px;
        background: #fbbf24;
        color: #111827;
    }

    .mp-btn-danger {
        border: none;
        cursor: pointer;
        font-weight: 1000;
        border-radius: 12px;
        padding: 12px 16px;
        background: #ef4444;
        color: #fff;
    }

    .mp-modal-bg {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.55);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 18px;
    }

    .mp-modal {
        width: min(520px, 96vw);
        background: #fff;
        border-radius: 18px;
        border: 1px solid #eadffd;
        box-shadow: 0 30px 80px rgba(15,23,42,.30);
        overflow: hidden;
    }

    .mp-modal-head {
        padding: 14px 16px;
        background: #faf8ff;
        border-bottom: 1px solid #eadffd;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .mp-modal-head b {
            font-weight: 1000;
            color: #312e81;
        }

    .mp-xbtn {
        border: none;
        background: transparent;
        font-size: 18px;
        cursor: pointer;
        font-weight: 1000;
        color: #111827;
    }

    .mp-modal-body {
        padding: 16px;
        color: #334155;
        font-weight: 750;
        line-height: 1.6;
    }

    .mp-modal-actions {
        padding: 14px 16px;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        border-top: 1px solid #eadffd;
    }

    @@media (max-width: 980px) {
        .mp-grid {
            grid-template-columns: 1fr;
        }

        .mp-fields {
            grid-template-columns: 1fr;
        }

        .mp-top {
            flex-direction: column;
        }

        .mp-top-btns {
            width: 100%;
            justify-content: flex-start;
        }
    }
</style>

<div class="mp-shell">

    <div class="mp-top">
        <div>
            <h1>@Localizer["MyProfile"]</h1>
            <p>@Localizer["ManageAccountAndUpdateDetails"]</p>
        </div>

        <div class="mp-top-btns">
            <button type="button" class="mp-btn" id="btnEditTop">✎ @Localizer["Edit"]</button>
        </div>
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="mp-msg">@TempData["Msg"]</div>
    }

    <div class="mp-grid">

        <aside class="mp-left-card">
            <div class="mp-left-hero">
                <div class="mp-pill">● @Localizer["Profile"]</div>

                <div>
                    <div class="mp-avatar">@((Model?.FullName ?? "C").Substring(0, 1).ToUpper())</div>
                    <div class="mp-name">@Model.FullName</div>
                    <div class="mp-sub">@Model.Email</div>
                    <div class="mp-verified">✓ @Localizer["VerifiedUser"]</div>
                </div>
            </div>

            <div class="mp-left-menu">
                <button type="button" class="mp-tab active" data-tab="personal">▢ @Localizer["PersonalInfo"]</button>
                <button type="button" class="mp-tab" data-tab="security">▢ @Localizer["Security"]</button>
                <button type="button" class="mp-tab" data-tab="help">▢ @Localizer["Help"]</button>
            </div>
        </aside>

        <section class="mp-right-card">

            <div id="tab-personal">
                <form method="post" action="/Citizen/MyProfile" id="profileForm">
                    @Html.AntiForgeryToken()

                    <div class="mp-section">
                        <div class="mp-sec-head">
                            <h3>▢ @Localizer["PersonalInformation"]</h3>
                            <button type="button" class="mp-edit-btn" id="btnEdit">✎ @Localizer["Edit"]</button>
                        </div>

                        <div class="mp-fields">
                            <div class="mp-field-box">
                                <small>@Localizer["FullName"]</small>
                                <input asp-for="FullName"
                                       id="FullName"
                                       readonly
                                       maxlength="100"
                                       autocomplete="off"
                                       inputmode="text"
                                       pattern="[A-Za-z\s]+" />
                                <span class="mp-field-error" asp-validation-for="FullName"></span>
                            </div>

                            <div class="mp-field-box">
                                <small>@Localizer["EmailLocked"]</small>
                                <input asp-for="Email" id="Email" readonly />
                                <span class="mp-field-error" asp-validation-for="Email"></span>
                            </div>

                            <div class="mp-field-box mp-full">
                                <small>@Localizer["Address"]</small>
                                <input asp-for="Address" id="Address" readonly placeholder="@Localizer["EnterAddressOptional"]" />
                                <span class="mp-field-error" asp-validation-for="Address"></span>

                                <div class="mp-hint">
                                    @Localizer["AddressTip"]
                                </div>
                            </div>
                        </div>

                        <div style="margin-top:14px; display:none;" id="saveRow">
                            <button type="submit" class="mp-edit-btn">@Localizer["SaveChanges"]</button>
                            <button type="button" class="mp-ghost-btn" id="btnCancelEdit" style="margin-left:10px;">@Localizer["Cancel"]</button>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div style="margin-top:12px; padding:12px 14px; border-radius:14px; border:1px solid #fecaca; background:#fff1f2; color:#991b1b; font-weight:900;">
                                @Localizer["FixErrorsAndTryAgain"]
                            </div>
                        }
                    </div>
                </form>
            </div>

            <div id="tab-security" style="display:none;">
                <div class="mp-section">
                    <div class="mp-sec-head">
                        <h3>▢ @Localizer["Security"]</h3>
                    </div>

                    <div class="mp-danger-zone">
                        <h4>@Localizer["DangerZone"]</h4>
                        <div style="color:#991b1b; font-weight:850; margin-bottom:12px;">
                            @Localizer["DeactivateOrDelete"]
                        </div>

                        <div class="mp-danger-actions">
                            <button type="button" class="mp-btn-warn" id="btnDeactivate">@Localizer["DeactivateAccount"]</button>
                            <button type="button" class="mp-btn-danger" id="btnDelete">@Localizer["DeleteAccount"]</button>
                            <a class="mp-ghost-btn" href="/Citizen/Dashboard">@Localizer["BackToDashboard"]</a>
                        </div>

                        <div style="margin-top:10px; color:#991b1b; font-weight:800; font-size:12px;">
                            @Localizer["DeleteIrreversible"]
                        </div>
                    </div>
                </div>
            </div>

            <div id="tab-help" style="display:none;">
                <div class="mp-section">
                    <div class="mp-sec-head">
                        <h3>▢ @Localizer["HelpSupport"]</h3>
                    </div>

                    <div style="background:#fff;border:1px solid #eadffd;border-radius:16px;padding:14px;font-weight:850;color:#475569;line-height:1.7;">
                        • @Localizer["HelpTip1"]<br />
                        • @Localizer["HelpTip2"]<br />
                        • @Localizer["HelpTip3"]
                    </div>

                    <div style="margin-top:12px; display:flex; gap:12px; flex-wrap:wrap;">
                        <a class="mp-ghost-btn" href="/Citizen/Notices">@Localizer["ViewNotices"]</a>
                        <a class="mp-ghost-btn" href="/Citizen/MyComplaints">@Localizer["MyComplaints"]</a>
                        <a class="mp-ghost-btn" href="/Citizen/TrackStatus">@Localizer["TrackStatus"]</a>
                    </div>
                </div>
            </div>

        </section>
    </div>
</div>

<div class="mp-modal-bg" id="modalBg">
    <div class="mp-modal">
        <div class="mp-modal-head">
            <b id="modalTitle">@Localizer["Confirm"]</b>
            <button class="mp-xbtn" type="button" id="modalClose">✕</button>
        </div>
        <div class="mp-modal-body" id="modalBody">@Localizer["AreYouSure"]</div>
        <div class="mp-modal-actions">
            <button type="button" class="mp-ghost-btn" id="modalCancel">@Localizer["Cancel"]</button>

            <form method="post" id="modalForm" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="mp-edit-btn" id="modalOk">@Localizer["YesContinue"]</button>
            </form>
        </div>
    </div>
</div>

<script>
    const txtYesContinue = '@Localizer["YesContinue"]';
    const txtDeactivateAccount = '@Localizer["DeactivateAccount"]';
    const txtDeactivateMessage = '@Localizer["DeactivateMessage"]';
    const txtDeactivate = '@Localizer["Deactivate"]';
    const txtDeleteAccount = '@Localizer["DeleteAccount"]';
    const txtDeleteMessage = '@Localizer["DeleteMessage"]';
    const txtDeletePermanently = '@Localizer["DeletePermanently"]';

    const tabs = document.querySelectorAll('.mp-tab');
    const personal = document.getElementById('tab-personal');
    const security = document.getElementById('tab-security');
    const help = document.getElementById('tab-help');

    tabs.forEach(t => {
        t.addEventListener('click', () => {
            tabs.forEach(x => x.classList.remove('active'));
            t.classList.add('active');

            const key = t.getAttribute('data-tab');
            personal.style.display = key === 'personal' ? '' : 'none';
            security.style.display = key === 'security' ? '' : 'none';
            help.style.display = key === 'help' ? '' : 'none';
        });
    });

    const btnEdit = document.getElementById('btnEdit');
    const btnEditTop = document.getElementById('btnEditTop');
    const btnCancelEdit = document.getElementById('btnCancelEdit');
    const saveRow = document.getElementById('saveRow');

    const fullName = document.getElementById('FullName');
    const address = document.getElementById('Address');
    const profileForm = document.getElementById('profileForm');

    let originalFullName = fullName.value;
    let originalAddress = address.value;

    function enableEdit(on) {
        if (on) {
            fullName.removeAttribute('readonly');
            address.removeAttribute('readonly');
            saveRow.style.display = '';
            document.querySelector('.mp-tab[data-tab="personal"]').click();
            fullName.focus();
        } else {
            fullName.setAttribute('readonly', 'readonly');
            address.setAttribute('readonly', 'readonly');
            saveRow.style.display = 'none';
            fullName.value = originalFullName;
            address.value = originalAddress;
        }
    }

    btnEdit.addEventListener('click', () => enableEdit(true));
    btnEditTop.addEventListener('click', () => enableEdit(true));
    btnCancelEdit.addEventListener('click', () => enableEdit(false));

    fullName.addEventListener('input', function () {
        this.value = this.value.replace(/[^A-Za-z\s]/g, '');
    });

    fullName.addEventListener('keypress', function (e) {
        const char = String.fromCharCode(e.which);
        if (!/[A-Za-z\s]/.test(char)) {
            e.preventDefault();
        }
    });

    profileForm.addEventListener('submit', function (e) {
        const value = fullName.value.trim();
        const valid = /^[A-Za-z\s]+$/.test(value);

        if (!valid) {
            e.preventDefault();
            alert('Full name can contain only letters and spaces.');
            fullName.focus();
        } else {
            originalFullName = fullName.value;
            originalAddress = address.value;
        }
    });

    const modalBg = document.getElementById('modalBg');
    const modalTitle = document.getElementById('modalTitle');
    const modalBody = document.getElementById('modalBody');
    const modalForm = document.getElementById('modalForm');
    const modalClose = document.getElementById('modalClose');
    const modalCancel = document.getElementById('modalCancel');
    const modalOk = document.getElementById('modalOk');

    function openModal(title, body, postUrl, okText, danger) {
        modalTitle.textContent = title;
        modalBody.textContent = body;
        modalForm.action = postUrl;
        modalOk.textContent = okText || txtYesContinue;

        if (danger) {
            modalOk.style.background = '#ef4444';
            modalOk.style.color = '#fff';
        } else {
            modalOk.style.background = '';
            modalOk.style.color = '';
        }

        modalBg.style.display = 'flex';
    }

    function closeModal() {
        modalBg.style.display = 'none';
    }

    modalClose.addEventListener('click', closeModal);
    modalCancel.addEventListener('click', closeModal);
    modalBg.addEventListener('click', (e) => {
        if (e.target === modalBg) closeModal();
    });

    document.getElementById('btnDeactivate').addEventListener('click', () => {
        openModal(
            txtDeactivateAccount,
            txtDeactivateMessage,
            '/Citizen/DeactivateAccount',
            txtDeactivate,
            false
        );
    });

    document.getElementById('btnDelete').addEventListener('click', () => {
        openModal(
            txtDeleteAccount,
            txtDeleteMessage,
            '/Citizen/DeleteAccount',
            txtDeletePermanently,
            true
        );
    });
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}