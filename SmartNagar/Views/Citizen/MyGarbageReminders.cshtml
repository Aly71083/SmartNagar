@model List<SmartNagar.Models.GarbageReminder>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    Layout = "~/Views/Citizen/_CitizenLayout.cshtml";
    ViewBag.Active = "garbageschedule";
    ViewBag.FullName = ViewBag.FullName ?? "Citizen";
}

<style>
    .title {
        font-size: 22px;
        font-weight: 1000;
        margin-bottom: 14px;
        color: #7c4dff;
    }

    .hero {
        background: linear-gradient(135deg,#7c4dff,#b197fc);
        color: white;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 18px 45px rgba(124,77,255,.25);
    }

        .hero h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 1000;
        }

        .hero p {
            margin-top: 8px;
            font-size: 13px;
            opacity: .95;
            font-weight: 750;
            line-height: 1.6;
        }

    .card {
        margin-top: 18px;
        background: #fff;
        border-radius: 18px;
        padding: 18px;
        border: 1px solid #eadffd;
        box-shadow: 0 10px 24px rgba(124,77,255,.08);
    }

        .card h3 {
            margin: 0 0 12px;
            color: #2f2347;
            font-size: 18px;
            font-weight: 1000;
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 12px;
        border-bottom: 1px solid #eef2f7;
        font-size: 14px;
        text-align: left;
        vertical-align: middle;
    }

    th {
        font-size: 12px;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 950;
        background: #faf7ff;
    }

    tbody tr:hover {
        background: #fcfaff;
    }

    .badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        background: #f3edff;
        color: #5b21b6;
        font-size: 12px;
        font-weight: 900;
        border: 1px solid #dccdfa;
    }

    .muted {
        color: #7b7198;
        font-weight: 700;
    }

    .btnRow {
        margin-top: 16px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        border: none;
        cursor: pointer;
        padding: 10px 14px;
        border-radius: 12px;
        font-weight: 900;
        font-size: 13px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btnPrimary {
        background: #7c4dff;
        color: white;
        box-shadow: 0 10px 22px rgba(124,77,255,.18);
    }

    .btnGhost {
        background: #f3edff;
        color: #2f2347;
        border: 1px solid #dccdfa;
    }

    .btnDel {
        border: none;
        cursor: pointer;
        background: #ef4444;
        color: #fff;
        padding: 8px 12px;
        border-radius: 12px;
        font-weight: 900;
        box-shadow: 0 10px 20px rgba(239,68,68,.16);
    }

        .btnDel:hover {
            background: #dc2626;
        }

    .empty {
        margin-top: 18px;
        padding: 16px;
        background: #fff;
        border: 1px dashed #d6c7fa;
        border-radius: 18px;
        text-align: center;
        font-weight: 900;
        color: #7b7198;
    }

    @@media(max-width:900px) {
        table, thead, tbody, th, td, tr {
            display: block;
        }

        thead {
            display: none;
        }

        tbody tr {
            margin-bottom: 12px;
            border: 1px solid #eadffd;
            border-radius: 14px;
            overflow: hidden;
            background: #fff;
        }

        td {
            border-bottom: 1px solid #f2ecff;
            position: relative;
            padding-left: 42%;
        }

            td:last-child {
                border-bottom: none;
            }

            td::before {
                position: absolute;
                left: 12px;
                top: 12px;
                width: 35%;
                font-weight: 900;
                color: #5b21b6;
                white-space: nowrap;
            }

            td:nth-child(1)::before {
                content: "Ward";
            }

            td:nth-child(2)::before {
                content: "Days";
            }

            td:nth-child(3)::before {
                content: "Time";
            }

            td:nth-child(4)::before {
                content: "Saved";
            }

            td:nth-child(5)::before {
                content: "Action";
            }
    }
</style>

<div class="title">
    📌 My Garbage Reminders
</div>

<div class="hero">
    <h3>Saved Reminder List</h3>
    <p>
        View all the garbage collection reminders you have saved by ward.<br />
        You can remove any reminder whenever needed.
    </p>
</div>

@if (TempData["Msg"] != null)
{
    <div class="card" style="background:#ecfdf5;border-color:#bbf7d0;color:#166534;font-weight:900;">
        @TempData["Msg"]
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="empty">No reminders saved yet.</div>
}
else
{
    <div class="card">
        <h3>📋 Saved Reminder Details</h3>

        <table>
            <thead>
                <tr>
                    <th>Ward</th>
                    <th>Collection Days</th>
                    <th>Collection Time</th>
                    <th>Saved On</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <span class="badge">Ward @r.WardNumber</span>
                        </td>
                        <td>@r.CollectionDays</td>
                        <td>@r.CollectionTime</td>
                        <td class="muted">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>
                            <form method="post" action="/Citizen/DeleteGarbageReminder">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btnDel">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="btnRow">
            <a class="btn btnGhost" href="/Citizen/GarbageSchedule">← Back to Garbage Schedule</a>
        </div>
    </div>
}    