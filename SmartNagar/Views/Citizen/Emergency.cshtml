            </p>
        </div>
        <div class="mini">@Localizer["EmergencyTipMobile"]</div>
    </div>

    <div class="btnRow">
        <button class="btn btnGreen" type="button" onclick="getLocation()">
            <i class="fa-solid fa-location-crosshairs"></i> @Localizer["GetMyLocation"]
        </button>
    </div>

    <div class="statusText" id="alertStatus"></div>
</div>

