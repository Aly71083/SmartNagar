                <p class="svcDesc">@Localizer["FireBrigadeDesc"]</p>
                <div class="btnRow">
                    <a class="btn" style="background:#a78bfa;color:#fff;" href="tel:101"><i class="fa-solid fa-phone"></i> @Localizer["Call"] 101</a>
