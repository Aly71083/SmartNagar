            <li>@Localizer["OperatorTip1"]</li>
            <li>@Localizer["OperatorTip2"]</li>
            <li>@Localizer["OperatorTip3"]</li>
            <li>@Localizer["OperatorTip4"]</li>
        </ul>
    </div>

    <div class="tip">
        <h4>📍 @Localizer["QuickLocationHelper"]</h4>
        <ul>
            <li>@Localizer["LocationTip1"]</li>
            <li>@Localizer["LocationTip2"]</li>
            <li>@Localizer["LocationTip3"]</li>
        </ul>

        <div class="btnRow" style="margin-top:12px;">
            <button class="btn btnGreen" type="button" onclick="getLocation()">
                <i class="fa-solid fa-location-crosshairs"></i> @Localizer["GetMyLocation"]
            </button>
            <button class="btn" type="button" onclick="copyLocation()">
                <i class="fa-regular fa-copy"></i> @Localizer["CopyLocation"]
            </button>
        </div>

        <div class="mini" id="locText" style="margin-top:10px;">@Localizer["LocationNotFetchedYet"]</div>
    </div>
</div>

<div class="note">
    ⚠️ @Localizer["EmergencyNote1"]
    <b>@Localizer["SubmitComplaint"]</b>.
</div>

@Html.AntiForgeryToken()

<script>
    let lastLocationText = "";

    const txtCopied = '@Localizer["Copied"]';
    const txtCopyFailed = '@Localizer["CopyFailed"]';
    const txtLocationUnsupported = '@Localizer["LocationUnsupported"]';
    const txtLocationFetching = '@Localizer["LocationFetching"]';
    const txtLocationLabel = '@Localizer["LocationLabel"]';
    const txtLocationDenied = '@Localizer["LocationDenied"]';
    const txtFetchLocationFirst = '@Localizer["FetchLocationFirst"]';

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value;
    }

    function copyText(t) {
        navigator.clipboard.writeText(t)
            .then(() => alert(txtCopied + ": " + t))
            .catch(() => alert(txtCopyFailed));
    }

    function getLocation() {
        const el = document.getElementById("locText");

        if (!navigator.geolocation) {
            el.innerText = txtLocationLabel + ": " + txtLocationUnsupported;
            return;
        }

        el.innerText = txtLocationLabel + ": " + txtLocationFetching;

        navigator.geolocation.getCurrentPosition(
            async (pos) => {
                const lat = pos.coords.latitude.toFixed(6);
                const lng = pos.coords.longitude.toFixed(6);
                lastLocationText = `Lat: ${lat}, Lng: ${lng}`;
                el.innerText = txtLocationLabel + ": " + lastLocationText;

                try {
                    await fetch('/Citizen/SaveMyLocation', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getAntiForgeryToken()
                        },
                        body: JSON.stringify({
                            lat: parseFloat(lat),
                            lng: parseFloat(lng)
                        })
                    });
                } catch (e) {
                    console.log("Location save failed.");
                }
            },
            () => {
                el.innerText = txtLocationLabel + ": " + txtLocationDenied;
            },
            { enableHighAccuracy: true, timeout: 8000 }
        );
    }

    function copyLocation() {
        if (!lastLocationText) {
            alert(txtFetchLocationFirst);
            return;
        }

        navigator.clipboard.writeText(lastLocationText)
            .then(() => alert(txtCopied + ": " + lastLocationText))
            .catch(() => alert(txtCopyFailed));
    }

    async function sendEmergencyAlert(alertType) {
        const statusEl = document.getElementById("alertStatus");

        const ok = confirm(`Are you sure you want to send ${alertType} alert?`);
        if (!ok) return;

        statusEl.innerText = `Sending ${alertType} alert...`;

        try {
            const formData = new URLSearchParams();
            formData.append("alertType", alertType);

            const response = await fetch('/Citizen/SendEmergencyAlert', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: formData.toString()
            });

            const data = await response.json();

            if (response.ok && data.ok) {
                statusEl.innerText = `✅ ${data.message}`;
                alert(data.message);
            } else {
                statusEl.innerText = "❌ Failed to send alert.";
                alert(data.message || "Failed to send alert.");
            }
        } catch (err) {
            statusEl.innerText = "❌ Error while sending alert.";
            alert("Error while sending alert.");
        }
    }
</script>