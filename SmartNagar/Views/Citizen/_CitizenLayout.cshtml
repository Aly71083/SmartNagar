@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    Layout = null;
    var fullName = ViewBag.FullName as string ?? Localizer["Citizen"].Value;
    var initial = !string.IsNullOrWhiteSpace(fullName) ? fullName.Substring(0, 1).ToUpper() : "C";

    var active = ViewBag.Active as string ?? "";
    Func<string, string> isActive = key => active == key ? "active" : "";

    var culture = CultureInfo.CurrentUICulture?.Name ?? "en-US";
    var isNepali = culture.StartsWith("ne", StringComparison.OrdinalIgnoreCase);

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - @Localizer["Citizen Portal"]</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: #f8f7fc;
            color: #2d2d2d;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, #6f66d9, #584fc7);
            color: #fff;
            padding: 20px 16px;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            padding: 8px 10px;
        }

        .brandIcon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: rgba(255,255,255,.18);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .brand h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 900;
        }

        .brand small {
            display: block;
            margin-top: 3px;
            opacity: .9;
            font-size: 12px;
        }

        .sectionTitle {
            margin: 18px 10px 8px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .8px;
            font-weight: 800;
            opacity: .8;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .menu a {
                color: #fff;
                text-decoration: none;
                padding: 12px 14px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 700;
                transition: .2s ease;
            }

                .menu a:hover,
                .menu a.active {
                    background: rgba(255,255,255,.18);
                }

        .sidebarSpacer {
            flex: 1;
        }

        .sidebarBottom {
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,.18);
        }

        .sidebarProfile {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.14);
            padding: 10px 12px;
            border-radius: 16px;
            margin-bottom: 12px;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #ffffff;
            color: #5c53c8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
        }

        .profileInfo {
            line-height: 1.2;
        }

            .profileInfo strong {
                display: block;
                color: #fff;
                font-size: 14px;
            }

            .profileInfo span {
                color: rgba(255,255,255,.82);
                font-size: 12px;
                font-weight: 600;
            }

        .sidebarLogoutForm {
            margin: 0;
        }

        .sidebarLogoutBtn {
            width: 100%;
            border: none;
            background: rgba(255,255,255,.16);
            color: #fff;
            padding: 12px 14px;
            border-radius: 14px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: .2s ease;
        }

            .sidebarLogoutBtn:hover {
                background: rgba(255,255,255,.24);
            }

        .main {
            margin-left: 260px;
            width: calc(100% - 260px);
            padding: 20px;
        }

        .topbar {
            background: #fff;
            border: 1px solid #ece8fb;
            border-radius: 20px;
            padding: 16px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            box-shadow: 0 8px 22px rgba(73, 61, 163, .06);
        }

            .topbar h1 {
                margin: 0;
                font-size: 24px;
                color: #2f2678;
                font-weight: 900;
            }

            .topbar p {
                margin: 5px 0 0;
                color: #7067a3;
                font-size: 13px;
                font-weight: 600;
            }

        .topActions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            position: relative;
        }

        .langForm {
            margin: 0;
        }

        .langSwitch {
            display: flex;
            align-items: center;
            background: #f5f2ff;
            border: 1px solid #e6defc;
            border-radius: 999px;
            padding: 4px;
            gap: 4px;
        }

        .langBtn {
            border: none;
            background: transparent;
            color: #5f52c7;
            padding: 8px 14px;
            border-radius: 999px;
            font-weight: 800;
            cursor: pointer;
        }

            .langBtn.active {
                background: #6f66d9;
                color: #fff;
            }

        .notifWrap {
            position: relative;
        }

        .notifBtn {
            width: 46px;
            height: 46px;
            border: 1px solid #e6defc;
            background: #f5f2ff;
            border-radius: 14px;
            cursor: pointer;
            position: relative;
            color: #5f52c7;
            font-size: 18px;
            transition: .2s ease;
        }

            .notifBtn:hover {
                background: #eee8ff;
            }

        .notifBadge {
            position: absolute;
            top: -5px;
            right: -5px;
            min-width: 22px;
            height: 22px;
            padding: 0 6px;
            border-radius: 999px;
            background: #ef4444;
            color: #fff;
            font-size: 11px;
            font-weight: 900;
            display: none;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
            box-shadow: 0 8px 20px rgba(239,68,68,.25);
        }

        .notifPanel {
            position: absolute;
            top: 58px;
            right: 0;
            width: 360px;
            background: #fff;
            border: 1px solid #e8defc;
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(92, 83, 200, .18);
            overflow: hidden;
            display: none;
            z-index: 1000;
        }

            .notifPanel.show {
                display: block;
            }

        .notifHead {
            padding: 14px 16px;
            border-bottom: 1px solid #f0ebff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            background: #fcfbff;
        }

            .notifHead strong {
                color: #2f2678;
                font-size: 15px;
            }

        .notifActions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .miniBtn {
            border: none;
            background: #eee8ff;
            color: #4b3eb5;
            padding: 8px 10px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
        }

            .miniBtn:hover {
                background: #e5dbff;
            }

        .notifBody {
            max-height: 360px;
            overflow-y: auto;
            padding: 12px;
        }

        .notifItem {
            padding: 12px;
            border: 1px solid #eee8ff;
            border-radius: 14px;
            background: #fff;
            margin-bottom: 10px;
        }

            .notifItem.unread {
                background: #faf8ff;
                border-color: #d8ccff;
            }

        .notifType {
            display: inline-block;
            margin-bottom: 8px;
            padding: 4px 8px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 900;
            background: #eee8ff;
            color: #5f52c7;
        }

            .notifType.notice {
                background: #e0f2fe;
                color: #0369a1;
            }

            .notifType.complaintupdate {
                background: #fef3c7;
                color: #b45309;
            }

            .notifType.resolved {
                background: #dcfce7;
                color: #15803d;
            }

            .notifType.garbage {
                background: #f3e8ff;
                color: #7e22ce;
            }

        .notifTitle {
            font-size: 14px;
            font-weight: 900;
            color: #2d2d2d;
            margin-bottom: 4px;
        }

        .notifText {
            font-size: 13px;
            color: #6f6a91;
            line-height: 1.5;
            font-weight: 700;
        }

        .notifTime {
            margin-top: 8px;
            font-size: 11px;
            color: #8e87b1;
            font-weight: 700;
        }

        .notifEmpty {
            padding: 20px;
            text-align: center;
            color: #7c74a5;
            font-weight: 800;
            font-size: 13px;
        }

        .content {
            margin-top: 16px;
        }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                width: 100%;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .notifPanel {
                width: 320px;
                right: -18px;
            }
        }
    </style>
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="brand">
                <div class="logo"><i class="fa-solid fa-landmark"></i></div>
                <div>
                    <h2>Smart Nagar</h2>
                    <small>@Localizer["Citizen Portal"]</small>
                </div>
            </div>

            <div class="sectionTitle">@Localizer["Main"]</div>
            <nav class="menu">
                <a class="@isActive("dashboard")" href="/Citizen/Dashboard">
                    <i class="fa-solid fa-house"></i> @Localizer["Home"]
                </a>
                <a class="@isActive("mycomplaints")" href="/Citizen/MyComplaints">
                    <i class="fa-solid fa-file-circle-exclamation"></i> @Localizer["My Complaints"]
                </a>
                <a class="@isActive("submitcomplaint")" href="/Citizen/SubmitComplaint">
                    <i class="fa-solid fa-pen-to-square"></i> @Localizer["Submit Complaint"]
                </a>
                <a class="@isActive("trackstatus")" href="/Citizen/TrackStatus">
                    <i class="fa-solid fa-magnifying-glass-location"></i> @Localizer["Track Status"]
                </a>
            </nav>

            <div class="sectionTitle">@Localizer["Services"]</div>
            <nav class="menu">
                <a class="@isActive("emergency")" href="/Citizen/Emergency">
                    <i class="fa-solid fa-triangle-exclamation"></i> @Localizer["Emergency"]
                </a>
                <a class="@isActive("garbageschedule")" href="/Citizen/GarbageSchedule">
                    <i class="fa-solid fa-trash"></i> @Localizer["Garbage Schedule"]
                </a>
            </nav>

            <div class="sectionTitle">@Localizer["Information"]</div>
            <nav class="menu">
                <a class="@isActive("notices")" href="/Citizen/Notices">
                    <i class="fa-solid fa-bullhorn"></i> @Localizer["Notices"]
                </a>
                <a class="@isActive("addreview")" href="/Citizen/AddReview">
                    <i class="fa-solid fa-star"></i> @Localizer["Add Review"]
                </a>
                <a class="@isActive("MyProfile")" href="/Citizen/MyProfile">
                    <i class="fa-solid fa-user"></i> @Localizer["My Profile"]
                </a>
            </nav>

            <div class="sidebarSpacer"></div>

            <div class="sidebarBottom">
                <div class="sidebarProfile">
                    <div class="avatar">@initial</div>
                    <div class="profileInfo">
                        <strong>@fullName</strong>
                        <span>@Localizer["Citizen"]</span>
                    </div>
                </div>

                <form method="post" action="/Account/Logout" class="sidebarLogoutForm">
                    @Html.AntiForgeryToken()
                    <button class="sidebarLogoutBtn" type="submit">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        @Localizer["Logout"]
                    </button>
                </form>
            </div>
        </aside>

        <main class="main">
            <div class="topbar">
                <div>
                    <h1>@Localizer["Welcome Back"]</h1>
                    <p>@Localizer["Portal Subtitle"]</p>
                </div>

                <div class="topActions">
                    <form class="langForm" method="post" action="/Settings/SetLanguage">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <div class="langSwitch">
                            <button type="submit" name="culture" value="en-US" class="langBtn @(isNepali ? "" : "active")">EN</button>
                            <button type="submit" name="culture" value="ne-NP" class="langBtn @(isNepali ? "active" : "")">नेपाली</button>
                        </div>
                    </form>

                    <div class="notifWrap">
                        <button type="button" class="notifBtn" id="citizenNotifBtn" onclick="toggleCitizenNotifPanel()">
                            <i class="fa-regular fa-bell"></i>
                            <span class="notifBadge" id="citizenNotifBadge">0</span>
                        </button>

                        <div class="notifPanel" id="citizenNotifPanel">
                            <div class="notifHead">
                                <strong>Notifications</strong>
                                <div class="notifActions">
                                    <button type="button" class="miniBtn" onclick="markAllCitizenRead()">Mark all read</button>
                                </div>
                            </div>

                            <div class="notifBody" id="citizenNotifBody">
                                <div class="notifEmpty">Loading notifications...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script>
        function toggleCitizenNotifPanel() {
            const panel = document.getElementById("citizenNotifPanel");
            panel.classList.toggle("show");

            if (panel.classList.contains("show")) {
                loadCitizenNotifications();
            }
        }

        document.addEventListener("click", function (e) {
            const wrap = document.querySelector(".notifWrap");
            if (wrap && !wrap.contains(e.target)) {
                const panel = document.getElementById("citizenNotifPanel");
                if (panel) panel.classList.remove("show");
            }
        });

        function getCitizenTypeClass(type) {
            const t = (type || "").toLowerCase().replace(/\s/g, "");
            if (t.includes("notice")) return "notice";
            if (t.includes("resolved")) return "resolved";
            if (t.includes("garbage")) return "garbage";
            if (t.includes("complaintupdate") || t.includes("assignment") || t.includes("status")) return "complaintupdate";
            return "";
        }

        async function refreshCitizenNotificationCount() {
            try {
                const res = await fetch('/Citizen/UnreadNotificationCount');
                if (!res.ok) return;

                const data = await res.json();
                const badge = document.getElementById("citizenNotifBadge");
                const count = data.count || 0;

                if (count > 0) {
                    badge.style.display = "flex";
                    badge.innerText = count > 99 ? "99+" : count;
                } else {
                    badge.style.display = "none";
                }
            } catch (e) {
                console.log("Citizen unread count load failed");
            }
        }

        async function loadCitizenNotifications() {
            const body = document.getElementById("citizenNotifBody");

            try {
                const res = await fetch('/Citizen/RecentNotifications');
                if (!res.ok) {
                    body.innerHTML = '<div class="notifEmpty">Could not load notifications.</div>';
                    return;
                }

                const items = await res.json();

                if (!items || items.length === 0) {
                    body.innerHTML = '<div class="notifEmpty">No notifications found.</div>';
                    return;
                }

                let html = '';

                items.forEach(item => {
                    const typeClass = getCitizenTypeClass(item.type);

                    html += `
                        <div class="notifItem ${item.isRead ? '' : 'unread'}">
                            <div class="notifType ${typeClass}">
                                ${item.type || 'Notification'}
                            </div>
                            <div class="notifTitle">${item.title || 'Notification'}</div>
                            <div class="notifText">${item.message || ''}</div>
                            <div class="notifTime">${item.createdAtText || ''}</div>
                        </div>
                    `;
                });

                body.innerHTML = html;
            } catch (e) {
                body.innerHTML = '<div class="notifEmpty">Could not load notifications.</div>';
            }
        }

        async function markAllCitizenRead() {
            try {
                const res = await fetch('/Citizen/MarkAllNotificationsRead', {
                    method: 'POST'
                });

                if (res.ok) {
                    await refreshCitizenNotificationCount();
                    await loadCitizenNotifications();
                }
            } catch (e) {
                console.log("Mark all citizen notifications read failed");
            }
        }

        refreshCitizenNotificationCount();
        setInterval(refreshCitizenNotificationCount, 15000);
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>