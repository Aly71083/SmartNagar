@model SmartNagar.ViewModels.AddReviewVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    Layout = "~/Views/Citizen/_CitizenLayout.cshtml";
    ViewBag.Active = "addreview";
    ViewBag.Title = Localizer["AddReview"].Value;
}

<style>
    .reviewWrap {
        max-width: 760px;
        margin: 0 auto;
    }

    .reviewHero {
        background: linear-gradient(135deg,#7c4dff,#d946ef);
        color: white;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 18px 50px rgba(124,77,255,.20);
        margin-bottom: 18px;
    }

        .reviewHero h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 1000;
        }

        .reviewHero p {
            margin: 8px 0 0;
            font-size: 14px;
            opacity: .95;
            line-height: 1.6;
        }

    .reviewCard {
        background: #fff;
        border: 1px solid #eadffd;
        border-radius: 22px;
        padding: 22px;
        box-shadow: 0 12px 30px rgba(124,77,255,.08);
    }

    .field {
        margin-bottom: 18px;
    }

        .field label {
            display: block;
            margin-bottom: 8px;
            font-weight: 900;
            color: #231942;
        }

    .select, .textarea {
        width: 100%;
        border: 1px solid #dccdfa;
        border-radius: 14px;
        padding: 12px 14px;
        font: inherit;
        outline: none;
    }

    .textarea {
        min-height: 140px;
        resize: vertical;
    }

    .btnRow {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btnPrimary {
        border: none;
        background: linear-gradient(135deg,#7c4dff,#d946ef);
        color: white;
        font-weight: 900;
        padding: 12px 18px;
        border-radius: 14px;
        cursor: pointer;
    }

    .btnGhost {
        text-decoration: none;
        border: 1px solid #d8c8fa;
        color: #7c4dff;
        background: white;
        padding: 12px 18px;
        border-radius: 14px;
        font-weight: 900;
    }

    .validation-summary-errors,
    .text-danger {
        color: #b91c1c;
        font-weight: 700;
        font-size: 13px;
    }
</style>

<div class="reviewWrap">
    <div class="reviewHero">
        <h2>@Localizer["AddYourReview"]</h2>
        <p>@Localizer["AddYourReviewSubtitle"]</p>
    </div>

    <div class="reviewCard">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All"></div>

            <div class="field">
                <label asp-for="Rating">@Localizer["StarRating"]</label>
                <select asp-for="Rating" class="select">
                    <option value="">@Localizer["SelectRating"]</option>
                    <option value="5">5 - @Localizer["Excellent"]</option>
                    <option value="4">4 - @Localizer["VeryGood"]</option>
                    <option value="3">3 - @Localizer["Good"]</option>
                    <option value="2">2 - @Localizer["Fair"]</option>
                    <option value="1">1 - @Localizer["Poor"]</option>
                </select>
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Comment">@Localizer["YourReview"]</label>
                <textarea asp-for="Comment" class="textarea" placeholder="@Localizer["WriteExperienceHere"]"></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <div class="btnRow">
                <button type="submit" class="btnPrimary">@Localizer["SubmitReview"]</button>
                <a href="/Citizen/Dashboard" class="btnGhost">@Localizer["Back"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}