@model List<SmartNagar.Models.GarbageSchedule>

@{
    Layout = "~/Views/Citizen/_CitizenLayout.cshtml";
    ViewBag.Active = "garbageschedule";
    ViewBag.FullName = ViewBag.FullName ?? "Citizen";

    var jsonData = System.Text.Json.JsonSerializer.Serialize(
        Model.Select(x => new
        {
            wardNumber = x.WardNumber,
            collectionDays = x.CollectionDays,
            collectionTime = x.CollectionTime,
            notes = x.Notes
        })
    );
}

<style>
    .title {
        font-size: 22px;
        font-weight: 1000;
        margin-bottom: 14px;
        color: #7c4dff;
    }

    .hero {
        background: linear-gradient(135deg,#7c4dff,#b197fc);
        color: white;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 18px 45px rgba(124,77,255,.25);
    }

        .hero h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 1000;
        }

        .hero p {
            margin-top: 8px;
            font-size: 13px;
            opacity: .95;
            font-weight: 750;
            line-height: 1.6;
        }

    .field {
        margin-top: 18px;
        background: #fff;
        padding: 16px;
        border-radius: 18px;
        border: 1px solid #eadffd;
        box-shadow: 0 10px 24px rgba(124,77,255,.08);
        max-width: 500px;
    }

    label {
        font-weight: 900;
        display: block;
        margin-bottom: 8px;
        color: #2f2347;
    }

    select {
        width: 100%;
        padding: 12px;
        border-radius: 12px;
        border: 1px solid #dccdfa;
        font-weight: 800;
        color: #2f2347;
        background: #fff;
        outline: none;
    }

        select:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 4px rgba(139,92,246,.10);
        }

    .card {
        margin-top: 18px;
        background: #fff;
        border-radius: 18px;
        padding: 18px;
        border: 1px solid #eadffd;
        box-shadow: 0 10px 24px rgba(124,77,255,.08);
    }

        .card h3 {
            margin: 0;
            color: #2f2347;
            font-size: 18px;
            font-weight: 1000;
        }

    .infoRow {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 12px;
        margin-top: 14px;
    }

    .box {
        background: #faf7ff;
        border-radius: 14px;
        padding: 12px;
        border: 1px solid #e9ddff;
    }

        .box .k {
            font-size: 12px;
            font-weight: 900;
            color: #7b7198;
            text-transform: uppercase;
        }

        .box .v {
            margin-top: 6px;
            font-weight: 900;
            font-size: 14px;
            color: #231942;
            line-height: 1.5;
        }

    .btnRow {
        margin-top: 16px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        border: none;
        cursor: pointer;
        padding: 10px 14px;
        border-radius: 12px;
        font-weight: 900;
        font-size: 13px;
    }

    .btnPrimary {
        background: #7c4dff;
        color: white;
        box-shadow: 0 10px 22px rgba(124,77,255,.18);
    }

    .btnGhost {
        background: #f3edff;
        color: #2f2347;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dccdfa;
    }

    .empty {
        margin-top: 18px;
        padding: 16px;
        background: #fff;
        border: 1px dashed #d6c7fa;
        border-radius: 18px;
        text-align: center;
        font-weight: 900;
        color: #7b7198;
    }

    .guideWrap {
        margin-top: 22px;
        background: linear-gradient(180deg, rgba(124,77,255,.20), rgba(124,77,255,.08));
        border-radius: 22px;
        padding: 22px;
    }

    .guidePanel {
        background: #fff;
        border-radius: 22px;
        padding: 26px;
        box-shadow: 0 18px 50px rgba(124,77,255,.10);
        border: 1px solid #eadffd;
    }

    .guideHead {
        text-align: center;
        margin-bottom: 18px;
    }

    .guideTitle {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 30px;
        font-weight: 1000;
        color: #231942;
        margin: 0;
    }

        .guideTitle .clip {
            font-size: 26px;
            background: #f3edff;
            border: 1px solid #dccdfa;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 18px rgba(124,77,255,.10);
        }

    .guideSub {
        margin: 8px 0 0;
        color: #7b7198;
        font-weight: 800;
        font-size: 14px;
    }

    .guideGrid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 16px;
        margin-top: 20px;
    }

    .gCard {
        background: #faf7ff;
        border-radius: 18px;
        padding: 18px;
        border: 1px solid #eadffd;
        box-shadow: 0 14px 30px rgba(124,77,255,.06);
        position: relative;
        overflow: hidden;
    }

        .gCard::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 5px;
            height: 100%;
            border-radius: 18px 0 0 18px;
            background: #7c4dff;
        }

    .gTop {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
    }

    .gIcon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: #fff;
        border: 1px solid #eadffd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        box-shadow: 0 10px 18px rgba(124,77,255,.08);
    }

    .gH {
        margin: 0;
        font-size: 18px;
        font-weight: 1000;
        color: #231942;
    }

    .gP {
        margin: 0;
        color: #6f678a;
        font-weight: 800;
        font-size: 13.5px;
        line-height: 1.6;
    }

    .bGreen::before {
        background: #7c4dff;
    }

    .bBlue::before {
        background: #8b5cf6;
    }

    .bOrange::before {
        background: #a78bfa;
    }

    .bRed::before {
        background: #c4b5fd;
    }

    @@media(max-width:900px) {
        .infoRow {
            grid-template-columns: 1fr;
        }

        .guideGrid {
            grid-template-columns: 1fr;
        }

        .guideTitle {
            font-size: 24px;
        }
    }
</style>

<div class="title">
    🗑 Garbage Collection Schedule
    <span style="font-size:13px;color:#7b7198;">Dhangadhi Sub-Metropolitan City</span>
</div>

<div class="hero">
    <h3>Ward-wise Garbage Collection</h3>
    <p>
        Select your ward to view collection details.<br />
        Below schedule comes from municipality admin.
    </p>
</div>

@if (TempData["Msg"] != null)
{
    <div class="card" style="background:#ecfdf5;border-color:#bbf7d0;color:#166534;font-weight:900;">
        @TempData["Msg"]
    </div>
}

<div class="field">
    <label>Select Ward</label>
    <select id="wardSelect" onchange="renderSchedule()">
        <option value="">-- Select Ward --</option>
        @for (int i = 1; i <= 19; i++)
        {
            <option value="@i">Ward @i</option>
        }
    </select>
</div>

<div id="resultArea"></div>

@Html.AntiForgeryToken()

<div class="guideWrap">
    <div class="guidePanel">
        <div class="guideHead">
            <h2 class="guideTitle">
                <span class="clip">📋</span>
                Important Guidelines
            </h2>
            <p class="guideSub">Follow these rules for proper waste management</p>
        </div>

        <div class="guideGrid">
            <div class="gCard bGreen">
                <div class="gTop">
                    <div class="gIcon">♻️</div>
                    <h3 class="gH">Segregate Waste</h3>
                </div>
                <p class="gP">Separate biodegradable and non-biodegradable waste before handing it over for collection.</p>
            </div>

            <div class="gCard bBlue">
                <div class="gTop">
                    <div class="gIcon">⏱️</div>
                    <h3 class="gH">Be On Time</h3>
                </div>
                <p class="gP">Keep your waste ready before the collection time to avoid missing the service.</p>
            </div>

            <div class="gCard bOrange">
                <div class="gTop">
                    <div class="gIcon">⚠️</div>
                    <h3 class="gH">Hazardous Waste</h3>
                </div>
                <p class="gP">Do not mix medical, chemical, or sharp objects with regular household waste.</p>
            </div>

            <div class="gCard bRed">
                <div class="gTop">
                    <div class="gIcon">💰</div>
                    <h3 class="gH">Avoid Penalties</h3>
                </div>
                <p class="gP">Improper disposal of waste may lead to warnings, penalties, or service restrictions.</p>
            </div>
        </div>
    </div>
</div>

<script>
    const schedules = @Html.Raw(jsonData);

    function getAntiForgeryToken() {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    function renderSchedule() {
        const ward = document.getElementById("wardSelect").value;
        const host = document.getElementById("resultArea");
        const token = getAntiForgeryToken();

        if (!ward) {
            host.innerHTML = `<div class="empty">Please select a ward first.</div>`;
            return;
        }

        const wardSchedule = schedules.find(x => String(x.wardNumber) === String(ward));

        if (!wardSchedule) {
            host.innerHTML = `
                <div class="empty">
                    No schedule currently available for Ward ${ward}.
                </div>
            `;
            return;
        }

        const notes = wardSchedule.notes && wardSchedule.notes.trim() !== ""
            ? wardSchedule.notes
            : "No additional notes";

        host.innerHTML = `
            <div class="card">
                <h3>📍 Ward ${wardSchedule.wardNumber} Collection Details</h3>

                <div class="infoRow">
                    <div class="box">
                        <div class="k">Collection Days</div>
                        <div class="v">${wardSchedule.collectionDays}</div>
                    </div>

                    <div class="box">
                        <div class="k">Collection Time</div>
                        <div class="v">${wardSchedule.collectionTime}</div>
                    </div>

                    <div class="box">
                        <div class="k">Notes</div>
                        <div class="v">${notes}</div>
                    </div>
                </div>

                <div class="btnRow">
                    <form method="post" action="/Citizen/SaveGarbageReminder">
                        <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                        <input type="hidden" name="wardNumber" value="${wardSchedule.wardNumber}" />
                        <button type="submit" class="btn btnPrimary">🔔 Add Reminder</button>
                    </form>

                    <a class="btn btnGhost" href="/Citizen/MyGarbageReminders">📌 My Reminders</a>
                </div>
            </div>
        `;
    }
</script>