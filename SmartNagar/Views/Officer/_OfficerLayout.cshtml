@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    Layout = null;

    var active = ViewBag.Active as string ?? "";
    var pageTitle = ViewBag.PageTitle as string ?? "Officer Portal";

    var fullName = ViewBag.FullName as string ?? User?.Identity?.Name ?? "Municipal Officer";
    var initial = !string.IsNullOrWhiteSpace(fullName) ? fullName.Substring(0, 1).ToUpper() : "M";

    Func<string, string> isActive = key => active == key ? "active" : "";

    var culture = CultureInfo.CurrentUICulture?.Name ?? "en-US";
    var isNepali = culture.StartsWith("ne", StringComparison.OrdinalIgnoreCase);

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - Smart Nagar</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --bg: #f4eefc;
            --sidebar1: #7c3aed;
            --sidebar2: #9f7aea;
            --white: #ffffff;
            --text: #2f1f52;
            --muted: #7d6d9d;
            --card: #ffffff;
            --border: #e9defa;
            --shadow: 0 10px 25px rgba(124, 58, 237, .10);
            --lightPurple: #f3ecff;
            --purple: #7c3aed;
            --purpleDark: #5b21b6;
            --danger: #ef4444;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", system-ui, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        a {
            text-decoration: none;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: linear-gradient(180deg, var(--sidebar1), var(--sidebar2));
            color: var(--white);
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            padding: 22px 14px 18px;
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 20px rgba(0,0,0,.08);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 10px 18px;
        }

        .brandIcon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(255,255,255,.18);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
        }

        .brandText strong {
            display: block;
            font-size: 18px;
            font-weight: 900;
            line-height: 1.1;
        }

        .brandText span {
            display: block;
            margin-top: 4px;
            font-size: 12px;
            opacity: .95;
            font-weight: 700;
        }

        .sectionTitle {
            margin: 18px 10px 8px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .9px;
            font-weight: 900;
            opacity: .82;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                color: #fff;
                padding: 13px 14px;
                border-radius: 14px;
                font-weight: 800;
                transition: .18s ease;
            }

                .menu a:hover,
                .menu a.active {
                    background: rgba(255,255,255,.18);
                }

        .sidebarSpacer {
            flex: 1;
        }

        .sidebarBottom {
            margin-top: 16px;
        }

        .profileCard {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255,255,255,.14);
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 16px;
            padding: 12px;
            margin-bottom: 12px;
        }

        .avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #fff;
            color: var(--purpleDark);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 16px;
            flex-shrink: 0;
        }

        .profileInfo {
            min-width: 0;
        }

            .profileInfo strong {
                display: block;
                color: #fff;
                font-size: 14px;
                font-weight: 900;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .profileInfo span {
                display: block;
                color: rgba(255,255,255,.88);
                font-size: 12px;
                font-weight: 700;
                margin-top: 2px;
            }

        .logoutForm {
            margin: 0;
        }

        .logoutBtn {
            width: 100%;
            border: none;
            background: rgba(255,255,255,.18);
            color: #fff;
            padding: 13px 14px;
            border-radius: 14px;
            font-weight: 900;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: .18s ease;
        }

            .logoutBtn:hover {
                background: rgba(255,255,255,.26);
            }

        .main {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
            padding: 22px 20px;
        }

        .topbar {
            background: rgba(255,255,255,.72);
            backdrop-filter: blur(6px);
            border: 1px solid #e8def8;
            border-radius: 22px;
            padding: 20px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            box-shadow: var(--shadow);
        }

            .topbar h1 {
                margin: 0;
                font-size: 24px;
                font-weight: 950;
                color: var(--purpleDark);
            }

            .topbar p {
                margin: 6px 0 0;
                font-size: 14px;
                color: #6f56c9;
                font-weight: 700;
            }

        .topActions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            position: relative;
        }

        .langForm {
            margin: 0;
        }

        .langSwitch {
            display: flex;
            align-items: center;
            background: #efe7ff;
            border: 1px solid #e1d3ff;
            border-radius: 999px;
            padding: 4px;
            gap: 4px;
        }

        .langBtn {
            border: none;
            background: transparent;
            color: var(--purpleDark);
            padding: 8px 16px;
            border-radius: 999px;
            font-weight: 900;
            cursor: pointer;
        }

            .langBtn.active {
                background: var(--purple);
                color: #fff;
            }

        .notifWrap {
            position: relative;
        }

        .notifBtn {
            width: 46px;
            height: 46px;
            border: 1px solid #e2d7fb;
            background: #f6f1ff;
            border-radius: 14px;
            cursor: pointer;
            position: relative;
            color: var(--purple);
            font-size: 18px;
            transition: .18s ease;
        }

            .notifBtn:hover {
                background: #eee5ff;
            }

        .notifBadge {
            position: absolute;
            top: -5px;
            right: -5px;
            min-width: 22px;
            height: 22px;
            padding: 0 6px;
            border-radius: 999px;
            background: var(--danger);
            color: #fff;
            font-size: 11px;
            font-weight: 900;
            display: none;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        .notifPanel {
            position: absolute;
            top: 58px;
            right: 0;
            width: 360px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(124, 58, 237, .18);
            overflow: hidden;
            display: none;
            z-index: 1000;
        }

            .notifPanel.show {
                display: block;
            }

        .notifHead {
            padding: 14px 16px;
            border-bottom: 1px solid #f0e9ff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            background: #fcfbff;
        }

            .notifHead strong {
                font-size: 15px;
                color: var(--purpleDark);
            }

        .notifActions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .miniBtn {
            border: none;
            background: #ede4ff;
            color: var(--purpleDark);
            padding: 8px 10px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .miniBtn:hover {
                background: #e4d7ff;
            }

        .notifBody {
            max-height: 360px;
            overflow-y: auto;
            padding: 12px;
        }

        .notifItem {
            padding: 12px;
            border: 1px solid #eee7ff;
            border-radius: 14px;
            background: #fff;
            margin-bottom: 10px;
        }

            .notifItem.unread {
                background: #faf7ff;
                border-color: #d8c9ff;
            }

        .notifType {
            display: inline-block;
            margin-bottom: 8px;
            padding: 4px 8px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 900;
            background: #eee5ff;
            color: var(--purple);
        }

            .notifType.emergency {
                background: #fee2e2;
                color: #b91c1c;
            }

        .notifTitle {
            font-size: 14px;
            font-weight: 900;
            color: var(--text);
            margin-bottom: 4px;
        }

        .notifText {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.5;
            font-weight: 700;
        }

        .notifTime {
            margin-top: 8px;
            font-size: 11px;
            color: #8a7ca7;
            font-weight: 700;
        }

        .notifEmpty {
            padding: 20px;
            text-align: center;
            color: var(--muted);
            font-weight: 800;
            font-size: 13px;
        }

        .pageBody {
            margin-top: 18px;
        }

        @@media (max-width: 900px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                width: 100%;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .notifPanel {
                width: 320px;
                right: -20px;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="brand">
                <div class="brandIcon">
                    <i class="fa-solid fa-building"></i>
                </div>
                <div class="brandText">
                    <strong>Smart Nagar</strong>
                    <span>Officer Portal</span>
                </div>
            </div>

            <div class="sectionTitle">Main</div>
            <nav class="menu">
                <a class="@isActive("dashboard")" href="/Officer/Dashboard">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>
                <a class="@isActive("complaints")" href="/Officer/Complaints">
                    <i class="fa-solid fa-file-circle-exclamation"></i> Complaints
                </a>
                <a class="@isActive("assignments")" href="/Officer/MyAssignments">
                    <i class="fa-solid fa-list-check"></i> My Assignments
                </a>
            </nav>

            <div class="sectionTitle">Management</div>
            <nav class="menu">
                <a class="@isActive("management")" href="/Officer/Management">
                    <i class="fa-solid fa-gear"></i> Management
                </a>
                <a class="@isActive("addcitizen")" href="/Officer/AddCitizen">
                    <i class="fa-solid fa-user-plus"></i> Add Citizen
                </a>
            </nav>

            <div class="sectionTitle">Reports</div>
            <nav class="menu">
                <a class="@isActive("analytics")" href="/Officer/Analytics">
                    <i class="fa-solid fa-chart-pie"></i> Analytics
                </a>
                <a class="@isActive("map")" href="/Officer/ActiveUsersMap">
                    <i class="fa-solid fa-map-location-dot"></i> Active Users Map
                </a>
            </nav>

            <div class="sidebarSpacer"></div>

            <div class="sidebarBottom">
                <div class="profileCard">
                    <div class="avatar">@initial</div>
                    <div class="profileInfo">
                        <strong>@fullName</strong>
                        <span>Officer</span>
                    </div>
                </div>

                <form method="post" action="/Account/Logout" class="logoutForm">
                    @Html.AntiForgeryToken()
                    <button class="logoutBtn" type="submit">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Logout
                    </button>
                </form>
            </div>
        </aside>

        <main class="main">
            <div class="topbar">
                <div>
                    <h1>@pageTitle</h1>
                    <p>Monitor complaints, assignments, and municipal operations</p>
                </div>

                <div class="topActions">
                    <form class="langForm" method="post" action="/Settings/SetLanguage">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <div class="langSwitch">
                            <button type="submit" name="culture" value="en-US" class="langBtn @(isNepali ? "" : "active")">EN</button>
                            <button type="submit" name="culture" value="ne-NP" class="langBtn @(isNepali ? "active" : "")">नेपाली</button>
                        </div>
                    </form>

                    <div class="notifWrap">
                        <button type="button" class="notifBtn" id="officerNotifBtn" onclick="toggleOfficerNotifPanel()">
                            <i class="fa-regular fa-bell"></i>
                            <span class="notifBadge" id="officerNotifBadge">0</span>
                        </button>

                        <div class="notifPanel" id="officerNotifPanel">
                            <div class="notifHead">
                                <strong>Notifications</strong>
                                <div class="notifActions">
                                    <button type="button" class="miniBtn" onclick="markAllOfficerRead()">Mark all read</button>
                                    <a href="/Officer/Notifications" class="miniBtn">View all</a>
                                </div>
                            </div>

                            <div class="notifBody" id="officerNotifBody">
                                <div class="notifEmpty">Loading notifications...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pageBody">
                @RenderBody()
            </div>
        </main>
    </div>

    <script>
        function toggleOfficerNotifPanel() {
            const panel = document.getElementById("officerNotifPanel");
            panel.classList.toggle("show");

            if (panel.classList.contains("show")) {
                loadOfficerNotifications();
            }
        }

        document.addEventListener("click", function (e) {
            const wrap = document.querySelector(".notifWrap");
            if (wrap && !wrap.contains(e.target)) {
                const panel = document.getElementById("officerNotifPanel");
                if (panel) panel.classList.remove("show");
            }
        });

        function getOfficerAntiForgeryToken() {
            const tokenInput = document.querySelector('.langForm input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        async function refreshOfficerNotificationCount() {
            try {
                const res = await fetch('/Officer/UnreadNotificationCount');
                if (!res.ok) return;

                const data = await res.json();
                const badge = document.getElementById("officerNotifBadge");
                const count = data.count || 0;

                if (count > 0) {
                    badge.style.display = "flex";
                    badge.innerText = count > 99 ? "99+" : count;
                } else {
                    badge.style.display = "none";
                }
            } catch (e) {
                console.log("Officer unread count load failed");
            }
        }

        async function loadOfficerNotifications() {
            const body = document.getElementById("officerNotifBody");

            try {
                const res = await fetch('/Officer/RecentNotificationsPreview');
                if (!res.ok) {
                    body.innerHTML = '<div class="notifEmpty">Could not load notifications.</div>';
                    return;
                }

                const items = await res.json();

                if (!items || items.length === 0) {
                    body.innerHTML = '<div class="notifEmpty">No notifications found.</div>';
                    return;
                }

                let html = '';

                items.forEach(item => {
                    const isEmergency = (item.type || '').toLowerCase().includes('emergency');

                    html += `
                        <div class="notifItem ${item.isRead ? '' : 'unread'}">
                            <div class="notifType ${isEmergency ? 'emergency' : ''}">
                                ${item.type || 'Notification'}
                            </div>
                            <div class="notifTitle">${item.title || 'Notification'}</div>
                            <div class="notifText">${item.message || item.detail || ''}</div>
                            <div class="notifTime">${item.createdAtText || ''}</div>
                        </div>
                    `;
                });

                body.innerHTML = html;
            } catch (e) {
                body.innerHTML = '<div class="notifEmpty">Could not load notifications.</div>';
            }
        }

        async function markAllOfficerRead() {
            try {
                const res = await fetch('/Officer/MarkAllNotificationsRead', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getOfficerAntiForgeryToken()
                    }
                });

                if (res.ok) {
                    await refreshOfficerNotificationCount();
                    await loadOfficerNotifications();
                }
            } catch (e) {
                console.log("Mark all officer notifications read failed");
            }
        }

        refreshOfficerNotificationCount();
        setInterval(refreshOfficerNotificationCount, 15000);
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>